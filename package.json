{
  "name": "nightglow",
  "version": "0.1.0",
  "main": "index.js",
  "author": "@micahstubbs <git@micah.fyi>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "swift build",
    "test": "swift test",
    "status": "swift run Nightglow --status",
    "probe": "swift run Nightglow --probe",
    "app": "scripts/build-app.sh",
    "install-app": "scripts/build-app.sh --install --open",
    "site-build": "scripts/build-site.sh",
    "site-test": "scripts/build-site.sh && node --test site/test/*.test.mjs",
    "site-serve": "scripts/build-site.sh && npx http-server site/dist -p 8765 -c-1",
    "site-deploy": "scripts/build-site.sh && ~/.claude/scripts/deploy-gh-pages.sh site/dist --domain nightglow.io",
    "dns": "scripts/configure-dns.sh",
    "dns-check": "scripts/configure-dns.sh --check",
    "site-verify": "node scripts/verify-site.mjs",
    "site-check": "scripts/check-live.sh"
  },
  "description": "Warm, sun-aware color temperature and brightness for every Mac display",
  "homepage": "https://nightglow.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/micahstubbs/nightglow.git"
  },
  "devDependencies": {
    "playwright": "1",
    "typescript": "5"
  }
}
